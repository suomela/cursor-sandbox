#!/bin/bash

project=$(printf '%s' "${PWD##*/}" |
    LC_ALL=C tr -c 'A-Za-z0-9_.-' '-')
container_name="codex-${project:-workspace}-$$"

docker run --rm -it \
    --name "$container_name" \
    --mount "type=volume,source=cursor-sandbox-home,target=/home/cursor" \
    --mount "type=bind,source=.,target=/workspace" \
    -w /workspace \
    "cursor-agent-sandbox" \
    bash -lc 'npx @openai/codex "$@"' bash \
        --sandbox=danger-full-access \
        --ask-for-approval=on-request \
        "$@"

printf '\033]0;\007'
